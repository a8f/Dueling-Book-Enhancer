{
  "manifest_version": 3,
  "name": "Dueling Book Enhancer",
  "version": "1.1.6",
  "description": "Customizes Dueling Book rooms, hosting defaults, Card Pools, colors, and deck sorting.",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Dueling Book Enhancer settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "19": "icons/icon-19.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png",
      "38": "icons/icon-38.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://duelingbook.com/*",
        "https://www.duelingbook.com/*"
      ],
      "js": [
        "bundled-banlists.js",
        "enhancer-core.js",
        "duel-events.js",
        "battle-damage.js",
        "activation-costs.js",
        "lifecycle.js",
        "features/debugging.js",
        "features/appearance.js",
        "features/rooms.js",
        "features/card-pools.js",
        "features/sorting.js",
        "features/rps.js",
        "features/turn-order.js",
        "features/battle-damage.js",
        "features/activation-costs.js",
        "features/hand-shuffle.js",
        "features/connection-health.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://duelingbook.com/*",
        "https://www.duelingbook.com/*"
      ],
      "js": [
        "settings-client.js",
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "bundled-banlists.js",
      "enhancer-core.js",
      "settings-store.js",
      "background.js"
    ]
  }
}
