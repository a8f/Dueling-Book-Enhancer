{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a8f.github.io/Dueling-Book-Enhancer/schemas/card-action-v2.schema.json",
  "title": "Card effect lifecycle v2 (spec 1)",
  "description": "Declarative effect lifecycle and reusable operations. This executable subset accepts two complete compositions; unsupported compositions remain rejected. Coverage records mandatory human responsibilities.",
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 160,
          "pattern": "\\S"
        },
        "passcode": {
          "type": "string",
          "pattern": "^[0-9]{8}$",
          "not": {
            "const": "00000000"
          }
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "name"
      ],
      "oneOf": [
        {
          "required": [
            "passcode"
          ],
          "not": {
            "required": [
              "id"
            ]
          }
        },
        {
          "required": [
            "id"
          ],
          "not": {
            "required": [
              "passcode"
            ]
          }
        }
      ]
    },
    "summon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "special-summon"
        },
        "from": {
          "const": "deck"
        },
        "card": {
          "$ref": "#/$defs/card"
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "choice": {
              "const": "position"
            }
          },
          "required": [
            "choice"
          ]
        },
        "reason": {
          "const": "effect"
        },
        "onNoMonsterZone": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "destroy"
            },
            "reason": {
              "const": "effect"
            }
          },
          "required": [
            "op",
            "reason"
          ]
        }
      },
      "required": [
        "op",
        "from",
        "card",
        "position",
        "reason"
      ]
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "search"
        },
        "from": {
          "const": "deck"
        },
        "to": {
          "const": "hand"
        },
        "filter": {
          "const": "monsters"
        },
        "count": {
          "const": 1
        },
        "reveal": {
          "const": true
        },
        "shuffle": {
          "const": true
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "check": {
                "const": "absent-face-up"
              },
              "cards": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/card"
                },
                "minItems": 0,
                "maxItems": 10
              }
            },
            "required": [
              "check",
              "cards"
            ]
          },
          "minItems": 0,
          "maxItems": 1
        }
      },
      "required": [
        "op",
        "from",
        "to",
        "filter",
        "count",
        "reveal",
        "shuffle",
        "checks"
      ]
    },
    "destroy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "destroy"
        },
        "reason": {
          "const": "effect"
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "at": {
              "const": "resolution"
            },
            "from": {
              "const": "field"
            },
            "players": {
              "const": "both"
            },
            "cardTypes": {
              "type": "array",
              "items": {
                "enum": [
                  "spell",
                  "trap"
                ]
              },
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true
            },
            "minimum": {
              "enum": [
                0,
                1
              ]
            },
            "maximum": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "count": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "zone": {
                      "const": "monster"
                    },
                    "player": {
                      "const": "self"
                    },
                    "faceUp": {
                      "const": true
                    },
                    "exclude": {
                      "const": "source"
                    },
                    "filter": {
                      "const": "monsters"
                    }
                  },
                  "required": [
                    "zone",
                    "player",
                    "faceUp",
                    "exclude",
                    "filter"
                  ]
                }
              },
              "required": [
                "count"
              ]
            }
          },
          "required": [
            "at",
            "from",
            "players",
            "cardTypes",
            "minimum",
            "maximum"
          ]
        }
      },
      "required": [
        "op",
        "reason",
        "selection"
      ]
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "branch"
        },
        "choice": {
          "const": "mode"
        },
        "cases": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "search": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/search"
              },
              "minItems": 1,
              "maxItems": 1
            },
            "destroy": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/destroy"
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "search",
            "destroy"
          ]
        }
      },
      "required": [
        "op",
        "choice",
        "cases"
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "zone": {
              "const": "graveyard"
            },
            "player": {
              "const": "self"
            }
          },
          "required": [
            "zone",
            "player"
          ]
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "ignition"
            },
            "turn": {
              "const": "self"
            },
            "phases": {
              "type": "array",
              "items": {
                "enum": [
                  "DP",
                  "SP",
                  "M1",
                  "BP",
                  "M2",
                  "EP"
                ]
              },
              "minItems": 1,
              "maxItems": 6,
              "uniqueItems": true
            },
            "verification": {
              "const": "manual"
            }
          },
          "required": [
            "kind",
            "turn",
            "phases",
            "verification"
          ]
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "check": {
                    "const": "absent-face-up"
                  },
                  "cards": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/card"
                    },
                    "minItems": 0,
                    "maxItems": 10
                  }
                },
                "required": [
                  "check",
                  "cards"
                ]
              },
              "minItems": 0,
              "maxItems": 1
            },
            "choices": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "const": "position"
                  },
                  "kind": {
                    "const": "position"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "ATK",
                        "DEF"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 2,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "options"
                ]
              },
              "minItems": 1,
              "maxItems": 1
            },
            "costs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "banish"
                  },
                  "card": {
                    "const": "source"
                  },
                  "reason": {
                    "const": "cost"
                  }
                },
                "required": [
                  "op",
                  "card",
                  "reason"
                ]
              },
              "minItems": 1,
              "maxItems": 1
            },
            "targets": {
              "type": "array",
              "items": {},
              "minItems": 0,
              "maxItems": 0
            }
          },
          "required": [
            "checks",
            "choices",
            "costs",
            "targets"
          ]
        },
        "resolution": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summon"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "const": "assisted"
            },
            "manual": {
              "type": "array",
              "items": {
                "enum": [
                  "activation-legality",
                  "responses-and-chains",
                  "negation",
                  "replacement-and-protection",
                  "movement-consequences",
                  "special-summon-legality",
                  "trigger-window",
                  "dynamic-card-properties",
                  "opponent-movement"
                ]
              },
              "minItems": 6,
              "maxItems": 9,
              "uniqueItems": true,
              "allOf": [
                {
                  "contains": {
                    "const": "activation-legality"
                  }
                },
                {
                  "contains": {
                    "const": "responses-and-chains"
                  }
                },
                {
                  "contains": {
                    "const": "negation"
                  }
                },
                {
                  "contains": {
                    "const": "replacement-and-protection"
                  }
                },
                {
                  "contains": {
                    "const": "movement-consequences"
                  }
                },
                {
                  "contains": {
                    "const": "special-summon-legality"
                  }
                }
              ]
            }
          },
          "required": [
            "level",
            "manual"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "source",
        "timing",
        "filters",
        "activation",
        "resolution",
        "coverage"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "zone": {
              "const": "monster"
            },
            "player": {
              "const": "self"
            }
          },
          "required": [
            "zone",
            "player"
          ]
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "optional-trigger"
            },
            "turn": {
              "const": "either"
            },
            "phases": {
              "type": "array",
              "items": {
                "enum": [
                  "DP",
                  "SP",
                  "M1",
                  "BP",
                  "M2",
                  "EP"
                ]
              },
              "minItems": 6,
              "maxItems": 6,
              "uniqueItems": true
            },
            "verification": {
              "const": "manual"
            },
            "events": {
              "type": "array",
              "items": {
                "enum": [
                  "normal-summon",
                  "special-summon"
                ]
              },
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true
            },
            "damageStep": {
              "const": true
            }
          },
          "required": [
            "kind",
            "turn",
            "phases",
            "verification",
            "events",
            "damageStep"
          ]
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "monsters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cardType": {
                  "const": "monster"
                },
                "cards": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/card"
                  },
                  "minItems": 1,
                  "maxItems": 500
                },
                "namePrefixes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 80,
                    "allOf": [
                      {
                        "pattern": "\\S"
                      },
                      {
                        "pattern": " $"
                      }
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 10
                }
              },
              "required": [
                "cardType"
              ],
              "oneOf": [
                {
                  "required": [
                    "cards"
                  ],
                  "not": {
                    "required": [
                      "namePrefixes"
                    ]
                  }
                },
                {
                  "required": [
                    "namePrefixes"
                  ],
                  "not": {
                    "required": [
                      "cards"
                    ]
                  }
                }
              ]
            }
          },
          "required": [
            "monsters"
          ]
        },
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checks": {
              "type": "array",
              "items": {},
              "minItems": 0,
              "maxItems": 0
            },
            "choices": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "const": "mode"
                  },
                  "kind": {
                    "const": "option"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "search",
                        "destroy"
                      ]
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "options"
                ]
              },
              "minItems": 1,
              "maxItems": 1
            },
            "costs": {
              "type": "array",
              "items": {},
              "minItems": 0,
              "maxItems": 0
            },
            "targets": {
              "type": "array",
              "items": {},
              "minItems": 0,
              "maxItems": 0
            }
          },
          "required": [
            "checks",
            "choices",
            "costs",
            "targets"
          ]
        },
        "resolution": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branch"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "const": "assisted"
            },
            "manual": {
              "type": "array",
              "items": {
                "enum": [
                  "activation-legality",
                  "responses-and-chains",
                  "negation",
                  "replacement-and-protection",
                  "movement-consequences",
                  "special-summon-legality",
                  "trigger-window",
                  "dynamic-card-properties",
                  "opponent-movement"
                ]
              },
              "minItems": 8,
              "maxItems": 9,
              "uniqueItems": true,
              "allOf": [
                {
                  "contains": {
                    "const": "activation-legality"
                  }
                },
                {
                  "contains": {
                    "const": "responses-and-chains"
                  }
                },
                {
                  "contains": {
                    "const": "negation"
                  }
                },
                {
                  "contains": {
                    "const": "replacement-and-protection"
                  }
                },
                {
                  "contains": {
                    "const": "movement-consequences"
                  }
                },
                {
                  "contains": {
                    "const": "trigger-window"
                  }
                },
                {
                  "contains": {
                    "const": "dynamic-card-properties"
                  }
                },
                {
                  "contains": {
                    "const": "opponent-movement"
                  }
                }
              ]
            }
          },
          "required": [
            "level",
            "manual"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "source",
        "timing",
        "filters",
        "activation",
        "resolution",
        "coverage"
      ]
    }
  ]
}
