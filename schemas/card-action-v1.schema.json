{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a8f.github.io/Dueling-Book-Enhancer/schemas/card-action-v1.schema.json",
  "title": "Card action definition v1 (spec 1)",
  "description": "Complete executable pipelines. Additional operations and subscriptions require an extension implementation and a new contract revision. Cross-selector identity/name consistency is checked by the runtime validator.",
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 160,
          "pattern": "\\S"
        },
        "passcode": {
          "type": "string",
          "pattern": "^[0-9]{8}$",
          "not": {
            "const": "00000000"
          }
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "name"
      ],
      "oneOf": [
        {
          "required": [
            "passcode"
          ],
          "not": {
            "required": [
              "id"
            ]
          }
        },
        {
          "required": [
            "id"
          ],
          "not": {
            "required": [
              "passcode"
            ]
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceZone": {
              "const": "graveyard"
            },
            "ownTurn": {
              "const": true
            },
            "phases": {
              "type": "array",
              "items": {
                "enum": [
                  "DP",
                  "SP",
                  "M1",
                  "BP",
                  "M2",
                  "EP"
                ]
              },
              "minItems": 1,
              "maxItems": 6,
              "uniqueItems": true
            },
            "absentFaceUpCards": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/card"
              },
              "minItems": 1,
              "maxItems": 10
            }
          },
          "required": [
            "sourceZone",
            "ownTurn",
            "phases"
          ]
        },
        "activation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "banish"
              },
              "card": {
                "const": "source"
              }
            },
            "required": [
              "op",
              "card"
            ]
          },
          "minItems": 1,
          "maxItems": 1
        },
        "resolution": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "special-summon"
              },
              "from": {
                "const": "deck"
              },
              "card": {
                "$ref": "#/$defs/card"
              },
              "positions": {
                "type": "array",
                "items": {
                  "enum": [
                    "ATK",
                    "DEF"
                  ]
                },
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true
              },
              "onNoMonsterZone": {
                "const": "destroy-to-graveyard"
              }
            },
            "required": [
              "op",
              "from",
              "card",
              "positions"
            ]
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "schemaVersion",
        "requires",
        "activation",
        "resolution"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceZone": {
              "const": "monster"
            },
            "ownTurn": {
              "const": false
            },
            "phases": {
              "type": "array",
              "items": {
                "enum": [
                  "DP",
                  "SP",
                  "M1",
                  "BP",
                  "M2",
                  "EP"
                ]
              },
              "minItems": 6,
              "maxItems": 6,
              "uniqueItems": true
            },
            "trigger": {
              "const": "normal-or-special-summon"
            }
          },
          "required": [
            "sourceZone",
            "ownTurn",
            "phases",
            "trigger"
          ]
        },
        "activation": {
          "type": "array",
          "items": {},
          "minItems": 0,
          "maxItems": 0
        },
        "resolution": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "choose-search-or-destroy"
              },
              "monsterNamePrefixes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 80,
                  "allOf": [
                    {
                      "pattern": "\\S"
                    },
                    {
                      "pattern": " $"
                    }
                  ]
                },
                "minItems": 1,
                "maxItems": 10
              },
              "monsterCards": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/card"
                },
                "minItems": 1,
                "maxItems": 500
              },
              "destructionMinimum": {
                "enum": [
                  0,
                  1
                ]
              },
              "searchAbsentFaceUpCards": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/card"
                },
                "minItems": 0,
                "maxItems": 10
              }
            },
            "required": [
              "op",
              "searchAbsentFaceUpCards"
            ],
            "oneOf": [
              {
                "required": [
                  "monsterCards"
                ],
                "not": {
                  "required": [
                    "monsterNamePrefixes"
                  ]
                }
              },
              {
                "required": [
                  "monsterNamePrefixes"
                ],
                "not": {
                  "required": [
                    "monsterCards"
                  ]
                }
              }
            ]
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "schemaVersion",
        "requires",
        "activation",
        "resolution"
      ]
    }
  ]
}
