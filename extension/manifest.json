{
  "manifest_version": 3,
  "name": "Dueling Book Enhancer",
  "version": "1.1.6",
  "description": "Customizes Dueling Book rooms, hosting defaults, Card Pools, colors, and deck sorting.",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Dueling Book Enhancer",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "19": "icons/icon-19.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png",
      "38": "icons/icon-38.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://duelingbook.com/*",
        "https://www.duelingbook.com/*"
      ],
      "js": [
        "data/bundled-banlists.js",
        "shared/enhancer-core.js",
        "page/duel-events.js",
        "shared/battle-damage.js",
        "shared/activation-costs.js",
        "page/lifecycle.js",
        "page/features/debugging.js",
        "page/features/appearance.js",
        "page/features/rooms.js",
        "page/features/card-pools.js",
        "page/features/sorting.js",
        "page/features/rps.js",
        "page/features/turn-order.js",
        "page/features/battle-damage.js",
        "page/features/activation-costs.js",
        "page/features/hand-shuffle.js",
        "page/features/connection-health.js",
        "page/content.js"
      ],
      "css": [
        "page/content.css"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://duelingbook.com/*",
        "https://www.duelingbook.com/*"
      ],
      "js": [
        "shared/settings-client.js",
        "bridge/bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "background": {
    "service_worker": "background/background.js",
    "scripts": [
      "data/bundled-banlists.js",
      "shared/enhancer-core.js",
      "shared/settings-store.js",
      "background/background.js"
    ]
  }
}
